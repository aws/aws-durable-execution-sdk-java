{"data":{"body":"[P2] This validates only that some target exists, allowing both `workgroupName` and `clusterIdentifier`; both `dbUser` and `secretArn` are likewise forwarded together. Redshift Data API requires one target and one compatible authentication mode, so these configurations fail only during export\u2014the provisioned test even constructs the invalid credential pair. Validate the mutually exclusive combinations at build time and add rejection tests.","comment_node_id":"PRRC_kwDOQwbyFc7uDr3X","finding_digest":"f5e79c4c41188aea5de12ad5457e1bfc1d9c10d25e52a405987e9e54039f6a7c","finding_id":"arf_v1_6xtzytcbdcfouxpbflkuk7q37q","finding_key":"insight-plugin/redshiftexporter::constructor::exclusive-target-auth-selection","identity_key":"insight-plugin/redshiftexporter::constructor::exclusive-target-auth-selection","line":40,"observation_digest":"028935cf65d80c22e7b4713f8e961a158dc015505a2a538447bf121e8a89644c","observation_id":"aro_v1_aketlt3f3agcfz5uoe7y5fq2cw","path":"insight-plugin/src/main/java/software/amazon/lambda/durable/insight/exporters/RedshiftExporter.java","prior_finding_id":"","published_at":"2026-09-11T22:38:31Z","review_id":"arr_v1_fvb4mdyhvhqy66uufdxoiwogo4","reviewed_base_sha":"7f1a73ca16308d31a1e5a270e504676caf890e0b","reviewed_head_sha":"360348e553f6a45c0fedda24ade3e79cf34b0f72","reviewer":"codex","start_line":39,"suggestion_id":""},"pull_request":{"number":704},"record_id":"art_v1_ynrdnrhu56niw3pe7o677dkvl7","record_type":"finding_observed","recorded_at":"2026-09-11T22:38:31Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

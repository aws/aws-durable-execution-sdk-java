{"data":{"body":"[P1] Use a non-reserved default event source. EventBridge reserves the `aws.` namespace for AWS service-generated events, so customer credentials can reject the default with `NotAuthorizedForSourceException`, making the exporter fail out of the box. Use a custom namespace such as `software.amazon.lambda.durable.insight` and update the test.","comment_node_id":"PRRC_kwDOQwbyFc7uFDy1","finding_digest":"1e9d62a4784d0e0f07d47f07e312fe42058588705c0e1a7a701a966717a668de","finding_id":"arf_v1_d2owfjdyjuha6b6up4d6gex6ii","finding_key":"insight-plugin/eventbridgeexporter::constructor::reserved-default-source","identity_key":"insight-plugin/eventbridgeexporter::constructor::reserved-default-source","line":31,"observation_digest":"4824b0ab26d9c31afb93237ad65ce0ec1640508adb15fb539e6fda561cddce67","observation_id":"aro_v1_jaslbkzg3hbrv64ten5nmxha5q","path":"insight-plugin/src/main/java/software/amazon/lambda/durable/insight/exporters/EventBridgeExporter.java","prior_finding_id":"","published_at":"2026-09-11T23:59:20Z","review_id":"arr_v1_dsz4gv2uaenyehudpwq7ak7gfu","reviewed_base_sha":"7f1a73ca16308d31a1e5a270e504676caf890e0b","reviewed_head_sha":"31041e66099621f3132e1db1765a716c2d304296","reviewer":"codex","start_line":31,"suggestion_id":""},"pull_request":{"number":704},"record_id":"art_v1_6ozlmvfxtdkczrwxnejemnmldu","record_type":"finding_observed","recorded_at":"2026-09-11T23:59:20Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

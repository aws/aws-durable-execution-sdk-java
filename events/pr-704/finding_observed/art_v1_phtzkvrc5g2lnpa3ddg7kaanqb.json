{"data":{"body":"[P1] Bound these HTTP requests and the equivalent OpenSearch request. Neither client has a connection or request timeout, and `onInvocationEnd()` drains exporter workers, so an unresponsive peer can hold the Lambda invocation until its own timeout. Add validated timeout options, configure the clients, apply `HttpRequest.timeout()`, and test slow endpoints.","comment_node_id":"PRRC_kwDOQwbyFc7u-iuc","finding_digest":"67ad3a262996d23846e945e04f7825c1c6d34ef717e33f2fbb5580687dbed696","finding_id":"arf_v1_m6wtujrjs3jdqrxjixqe66bfyh","finding_key":"insight-plugin/http-exporters::send::bounded-invocation-lifetime","identity_key":"insight-plugin/http-exporters::send::bounded-invocation-lifetime","line":98,"observation_digest":"13c791bdc79399569a99b89846548602ce3fffc1097d5bf4cb84932b430c7b13","observation_id":"aro_v1_cpdzdpohsomvnguzxcmemvegal","path":"insight-plugin/src/main/java/software/amazon/lambda/durable/insight/exporters/OTelExporter.java","prior_finding_id":"arf_v1_m6wtujrjs3jdqrxjixqe66bfyh","published_at":"2026-09-14T20:38:00Z","review_id":"arr_v1_73go55s6yw7ve2tkufpklz322d","reviewed_base_sha":"7f1a73ca16308d31a1e5a270e504676caf890e0b","reviewed_head_sha":"c66fb370169b3201ca753b03a7ecf3c4f45d8f8f","reviewer":"codex","start_line":96,"suggestion_id":""},"pull_request":{"number":704},"record_id":"art_v1_phtzkvrc5g2lnpa3ddg7kaanqb","record_type":"finding_observed","recorded_at":"2026-09-14T20:38:00Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

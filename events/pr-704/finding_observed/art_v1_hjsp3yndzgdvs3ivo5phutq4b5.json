{"data":{"body":"[P1] This in-memory lock does not protect the advertised EFS use case. Concurrent Lambda execution environments have separate `FileExporter` instances and locks, so their multi-chunk appends to the shared date file can interleave and corrupt NDJSON. Hold a cross-process `FileChannel` lock for the complete write or use per-execution files, and test independent writers.","comment_node_id":"PRRC_kwDOQwbyFc7u-i2H","finding_digest":"0319fde4220a65bd5f1ec94d7052f319e4b51b46b2bafb5c7772137d11137a57","finding_id":"arf_v1_amm73zbcbjs32xy6zfgxauxtdh","finding_key":"insight-plugin/fileexporter::ndjson-append::cross-process-record-atomicity","identity_key":"insight-plugin/fileexporter::ndjson-append::cross-process-record-atomicity","line":100,"observation_digest":"cd58b162e163f9df5065bc3539e14b119b2fc8d9582211a8321b91ba9c9e2500","observation_id":"aro_v1_zvmlcyxbmp456udfxq2ttyklcg","path":"insight-plugin/src/main/java/software/amazon/lambda/durable/insight/exporters/FileExporter.java","prior_finding_id":"","published_at":"2026-09-14T20:38:04Z","review_id":"arr_v1_73go55s6yw7ve2tkufpklz322d","reviewed_base_sha":"7f1a73ca16308d31a1e5a270e504676caf890e0b","reviewed_head_sha":"c66fb370169b3201ca753b03a7ecf3c4f45d8f8f","reviewer":"codex","start_line":95,"suggestion_id":""},"pull_request":{"number":704},"record_id":"art_v1_hjsp3yndzgdvs3ivo5phutq4b5","record_type":"finding_observed","recorded_at":"2026-09-14T20:38:04Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

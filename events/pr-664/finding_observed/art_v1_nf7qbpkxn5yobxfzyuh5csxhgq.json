{"data":{"body":"**[P2] Search beyond Maven XML tags**\n\nRequiring an exact `<artifactId>` tag skips Gradle/Kotlin DSL, inline coordinates, and versioned plugin filenames, despite the checklist requiring every literal SDK version to be updated. Search for the artifact-name pattern itself so all dependency syntaxes are covered.","comment_node_id":"PRRC_kwDOQwbyFc7oVNBE","finding_digest":"a5b54e2e4d6bde6df53a8b8c35c8f0f13b6f4de1a8c43a23cf7abacfd0318823","finding_id":"arf_v1_uw2u4lsnnppg35j2rogdlshq6e","finding_key":"release.md::shared-documentation-search::dependency-syntax-coverage","identity_key":"release.md::shared-documentation-search::dependency-syntax-coverage","line":90,"observation_digest":"4ac54f9228552f839005df37beb28fda294370404ac9d9992b743e86ee5f4a29","observation_id":"aro_v1_jlcu7erikuxyheaf34335mup3i","path":"RELEASE.md","prior_finding_id":"","published_at":"2026-08-31T19:56:24Z","review_id":"arr_v1_fqobqdj6wpbelqo6mte7lgdj6d","reviewed_base_sha":"6501c39f553655583e33238eb1d821e4f44b8e26","reviewed_head_sha":"78bcb2f305db80cb459b6a87458fe3d17e741aa5","reviewer":"codex","start_line":90,"suggestion_id":"arsg_v1_g4qn3hlfvxrujhy3brlgs3nsr6"},"pull_request":{"number":664},"record_id":"art_v1_nf7qbpkxn5yobxfzyuh5csxhgq","record_type":"finding_observed","recorded_at":"2026-08-31T19:56:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P1] Make legacy detection collision-safe.** This marker was not historically reserved, and a custom `SerDes` may already have checkpointed the same prefix or shape. Such data would be decoded as an envelope or rejected after enabling offloading. Use out-of-band format metadata or another migration scheme that never interprets arbitrary legacy strings as envelopes, and test a legacy payload matching the proposed marker.","comment_node_id":"PRRC_kwDOQwbyFc7poeJB","finding_digest":"89c91c6201b382e5b39e9a6cbf1ae8f65c859d43a2ee0b02f8d79ab692d27195","finding_id":"arf_v1_rheryyqbwobolm46tjwl6gxi6z","finding_key":"docs/adr/006-java-payload-offloading.md::replay-envelope::legacy-raw-payload-compatibility","identity_key":"docs/adr/006-java-payload-offloading.md::replay-envelope::legacy-raw-payload-compatibility","line":357,"observation_digest":"a2a8dd9739e1ba75fb64928a203e7e34c958f5b1d64898076ce21557f95e234e","observation_id":"aro_v1_ukun3fzz4g5hl63eskfcapt6gt","path":"docs/adr/006-java-payload-offloading.md","prior_finding_id":"arf_v1_rheryyqbwobolm46tjwl6gxi6z","published_at":"2026-09-02T23:40:24Z","review_id":"arr_v1_y5glwmc4oneokxagbuao6qqlil","reviewed_base_sha":"54b01c910cb06c69336afcb2c5f3f220fbe7b0b0","reviewed_head_sha":"4c6822cc220948aebb437a95ebe6acc0cb1c2175","reviewer":"codex","start_line":352,"suggestion_id":""},"pull_request":{"number":678},"record_id":"art_v1_nk4kj22xkuirb2lfzm7jw6ldcq","record_type":"finding_observed","recorded_at":"2026-09-02T23:40:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

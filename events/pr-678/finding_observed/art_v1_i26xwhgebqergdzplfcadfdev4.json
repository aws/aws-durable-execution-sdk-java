{"data":{"body":"**[P1] Make legacy detection collision-safe.** `SerDes` historically permits arbitrary strings, so an existing checkpoint\u2014or raw payload written while offloading was disabled\u2014may already match the marker and be misread as an envelope. Use out-of-band format metadata or another migration scheme that cannot reinterpret legacy user data, and test a valid legacy payload matching the proposed marker.","comment_node_id":"PRRC_kwDOQwbyFc7ppyes","finding_digest":"89c91c6201b382e5b39e9a6cbf1ae8f65c859d43a2ee0b02f8d79ab692d27195","finding_id":"arf_v1_rheryyqbwobolm46tjwl6gxi6z","finding_key":"docs/adr/006-java-payload-offloading.md::replay-envelope::legacy-raw-payload-compatibility","identity_key":"docs/adr/006-java-payload-offloading.md::replay-envelope::legacy-raw-payload-compatibility","line":354,"observation_digest":"a1a18e3e4ee80202593dd17f0e0876266d69365286f383dc029ea6a67349fc8f","observation_id":"aro_v1_ugqy4pso5abaewj52f7q4cdwez","path":"docs/adr/006-java-payload-offloading.md","prior_finding_id":"arf_v1_rheryyqbwobolm46tjwl6gxi6z","published_at":"2026-09-03T00:53:53Z","review_id":"arr_v1_3akhipwlxgh53mzfcxrph3hpjl","reviewed_base_sha":"54b01c910cb06c69336afcb2c5f3f220fbe7b0b0","reviewed_head_sha":"4d751be9025f5188d73fa525dd0e72105d864f40","reviewer":"codex","start_line":354,"suggestion_id":""},"pull_request":{"number":678},"record_id":"art_v1_i26xwhgebqergdzplfcadfdev4","record_type":"finding_observed","recorded_at":"2026-09-03T00:53:53Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

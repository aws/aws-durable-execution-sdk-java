{"data":{"body":"**[P2] Make preview data immutable and wire-safe.** This record exposes the offloader's mutable `Map<String, Object>` directly; concurrent mutation can change the envelope after sizing or cause serialization failures, and arbitrary object graphs undermine a stable SDK-owned format. Constrain previews to a defined wire type and defensively deep-copy them in the public model.","comment_node_id":"PRRC_kwDOQwbyFc7poeMf","finding_digest":"645d6f8bab60ff2339163b1d87e4bf7d957597e0dfef1b016c90983a2e855258","finding_id":"arf_v1_mrow7c5lmd7sgoiwhmoypzf7pw","finding_key":"docs/adr/006-java-payload-offloading.md::stored-payload-preview::immutable-wire-value","identity_key":"docs/adr/006-java-payload-offloading.md::stored-payload-preview::immutable-wire-value","line":309,"observation_digest":"65a8f3123788557ba2f0ca3397df3fa9174c337fd29272f9229ebd2fbce7b2a4","observation_id":"aro_v1_mwupgerxrbkxxixqzizzpxz7ve","path":"docs/adr/006-java-payload-offloading.md","prior_finding_id":"","published_at":"2026-09-02T23:40:27Z","review_id":"arr_v1_y5glwmc4oneokxagbuao6qqlil","reviewed_base_sha":"54b01c910cb06c69336afcb2c5f3f220fbe7b0b0","reviewed_head_sha":"4c6822cc220948aebb437a95ebe6acc0cb1c2175","reviewer":"codex","start_line":307,"suggestion_id":""},"pull_request":{"number":678},"record_id":"art_v1_lb4ju4gce3zv2m24nkaz24wnmu","record_type":"finding_observed","recorded_at":"2026-09-02T23:40:27Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

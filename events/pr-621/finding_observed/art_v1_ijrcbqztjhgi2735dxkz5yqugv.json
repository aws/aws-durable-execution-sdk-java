{"data":{"body":"**[P1] Gate layer publication on the successful Maven release.** This independent release workflow can publish public layers even if `publish_maven.yml` later fails its test build, signing, or Central upload, leaving a layer whose matching SDK version was never released. Run it as a dependent/reusable job after Maven publication succeeds, or use a success-only `workflow_run` tied to the same tag and SHA.","comment_node_id":"PRRC_kwDOQwbyFc7sHb6T","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":5,"observation_digest":"38e9671f13aadea0e59ba369a3d75012745aacf439e007daccca0856b1124c0a","observation_id":"aro_v1_hduwohytvlpkbzm3unu2hv2qcj","path":".github/workflows/lambda-layer-publish.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-08T19:13:21Z","review_id":"arr_v1_ltk43swq6fdlkr3kjyp5ywdpo6","reviewed_base_sha":"57ecdf7bd45d9930b551ce9964e5d7aff565fe27","reviewed_head_sha":"2d3611c8f9115a6bb308c2bd9eae404ffe45ffd6","reviewer":"codex","start_line":4,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_ijrcbqztjhgi2735dxkz5yqugv","record_type":"finding_observed","recorded_at":"2026-09-08T19:13:21Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P1] Gate public layer publication on Maven Central availability.** The `publish` job only stages artifacts with `autoPublish=false`; it does not make the matching SDK resolvable from Central. This dependency can therefore publish the public layer before users can obtain its required SDK version. Trigger this job only after an explicit Central availability check or from a separate post-approval workflow.","comment_node_id":"PRRC_kwDOQwbyFc7sQZ5s","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"d357622f1b6e240d473169c4fd60cabb1c0800b15fd746bb1299f616a84b98db","observation_id":"aro_v1_2nlwely3nysa2rzrnhcp2ygkxm","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-09T01:13:39Z","review_id":"arr_v1_afho3ddh2a6emtvzgkoqep7vls","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"6d666edbc836a8a1d85481228d18162a9ca8cfa9","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_67aozpnx3vun2xkjpfkjtw3jf3","record_type":"finding_observed","recorded_at":"2026-09-09T01:13:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

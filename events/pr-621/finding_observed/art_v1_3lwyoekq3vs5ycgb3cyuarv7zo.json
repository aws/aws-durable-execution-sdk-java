{"data":{"body":"**[P1] Wait for Maven Central publication, not this combined job.** `publish` returns after uploading with `autoPublish=false`, then performs unrelated version-bump automation. The layer can therefore become public while its matching SDK is still pending manual Central publication, while a bump/PR failure can suppress layer publication after upload. Split these stages and make this job depend on explicit Central availability verification.","comment_node_id":"PRRC_kwDOQwbyFc7sP-id","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"3f8f65ff75540898625cd414c549ef9dcf88511e6eab9450a5e0823f09880b28","observation_id":"aro_v1_h6hwl73vkqejqys42qkmkspptx","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-09T00:50:12Z","review_id":"arr_v1_ohqlrycmh2xizufzrq3xlmr5ra","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"15665f85d25ba7e53d495344535b74590a3d0b09","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_3lwyoekq3vs5ycgb3cyuarv7zo","record_type":"finding_observed","recorded_at":"2026-09-09T00:50:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P1] Pass the immutable release checkout SHA.** The Maven artifacts are built before this job re-resolves the mutable tag, so a moved tag can make the public layer contain different code from the Maven release. Export the SHA from the original release checkout, pass it here, and verify the tag still resolves to that SHA.","comment_node_id":"PRRC_kwDOQwbyFc7sPwki","finding_digest":"5c5650029ab1e33b63713d40d7c9a322e6f265eea7abdc5c978905cf23050417","finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","finding_key":"publish_maven::publish-layer::immutable-source-selection","identity_key":"publish_maven::publish-layer::immutable-source-selection","line":148,"observation_digest":"6b75275f36bac456de788452b922b694033270f5821390c834badb6d63f63249","observation_id":"aro_v1_nn2soxzwxlcfnxtyqrjlsivwsq","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","published_at":"2026-09-09T00:37:40Z","review_id":"arr_v1_3sofkfxs5cm4hui7ldmiaka3vy","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"79c4c665561c465edc728cd1d2c73270b764a062","reviewer":"codex","start_line":148,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_5bdfk4qfg3sqtcbro5dc5nf5gw","record_type":"finding_observed","recorded_at":"2026-09-09T00:37:40Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

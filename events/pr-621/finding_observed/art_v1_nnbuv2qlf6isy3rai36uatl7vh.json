{"data":{"body":"**[P1] Wait for actual Maven Central publication.** `needs: publish` only waits for deployments uploaded with `autoPublish=false`; `RELEASE.md` requires a later manual publish in Central. The layer can therefore become public while its matching SDK is unavailable or ultimately rejected. Split out a publication milestone that verifies Central availability (or resumes after manual approval), depend on that, and keep version-bump PR automation independent.","comment_node_id":"PRRC_kwDOQwbyFc7sLAAs","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"fc98e7f3b88b2a07543e4997adda0a0c81fbaece207d72ff70ee9227446f6f1d","observation_id":"aro_v1_7smop45yrmvaovb6jgl23wqkbs","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-08T21:13:56Z","review_id":"arr_v1_2btwq4pkwgus6lu66q7eptcgwk","reviewed_base_sha":"57ecdf7bd45d9930b551ce9964e5d7aff565fe27","reviewed_head_sha":"49c371c95aa81844ab885d45bcb3784c72163dd7","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_nnbuv2qlf6isy3rai36uatl7vh","record_type":"finding_observed","recorded_at":"2026-09-08T21:13:56Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

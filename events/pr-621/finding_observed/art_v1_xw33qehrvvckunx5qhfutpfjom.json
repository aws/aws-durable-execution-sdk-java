{"data":{"body":"**[P1] Gate public layer publication on Maven Central availability.** `publish` only uploads with `autoPublish=false` and then performs version-bump automation. The layer can therefore become public before its matching SDK is available, while a later branch/PR failure can suppress the layer despite successful uploads. Split these stages and invoke this workflow only after an explicit Central availability check or separate post-approval workflow.","comment_node_id":"PRRC_kwDOQwbyFc7sQHKh","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"ff86cccd6cda5ca3f08785c453a9f46fdab792d736afc265896f2eba4bf3fce9","observation_id":"aro_v1_76dmztlm3jokh4ehqxcfhkpun7","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-09T00:57:53Z","review_id":"arr_v1_mdbfomnjk5vfmshfweexnhllk7","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"0eabe9a3a6a5cb7067c6faec598d6eaf60a3010c","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_xw33qehrvvckunx5qhfutpfjom","record_type":"finding_observed","recorded_at":"2026-09-09T00:57:53Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

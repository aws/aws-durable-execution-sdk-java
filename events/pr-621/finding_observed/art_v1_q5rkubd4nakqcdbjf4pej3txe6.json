{"data":{"body":"**[P1] Pin the layer build to the release checkout SHA.** Passing the tag re-resolves a mutable ref after the Maven artifacts were built. If it moves between jobs, the public layer can contain different code while the current version and ancestry checks still pass. Export the original checkout's `git rev-parse HEAD`, pass that SHA here, and verify the tag still resolves to it.","comment_node_id":"PRRC_kwDOQwbyFc7sP-lH","finding_digest":"5c5650029ab1e33b63713d40d7c9a322e6f265eea7abdc5c978905cf23050417","finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","finding_key":"publish_maven::publish-layer::immutable-source-selection","identity_key":"publish_maven::publish-layer::immutable-source-selection","line":148,"observation_digest":"186b71ea00ed5d5dd846387b93ea8a964f8a5d9bd3e87ff3afc238782d631fcd","observation_id":"aro_v1_dbvxd2qa5vov3wcghb5zh2uksz","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","published_at":"2026-09-09T00:50:14Z","review_id":"arr_v1_ohqlrycmh2xizufzrq3xlmr5ra","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"15665f85d25ba7e53d495344535b74590a3d0b09","reviewer":"codex","start_line":148,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_q5rkubd4nakqcdbjf4pej3txe6","record_type":"finding_observed","recorded_at":"2026-09-09T00:50:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P1] Pin the layer build to the release checkout SHA.** This passes a mutable tag that is resolved again after the Maven artifacts were built. If the tag moves meanwhile, the public layer can contain different code while the version and ancestry checks still pass. Capture and export `git rev-parse HEAD` from the release checkout, pass that SHA here, and verify the tag still resolves to it.","comment_node_id":"PRRC_kwDOQwbyFc7sQHJA","finding_digest":"5c5650029ab1e33b63713d40d7c9a322e6f265eea7abdc5c978905cf23050417","finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","finding_key":"publish_maven::publish-layer::immutable-source-selection","identity_key":"publish_maven::publish-layer::immutable-source-selection","line":148,"observation_digest":"1c54fda544bad9db1c60c12b3c68d74679d560c6f86179be77300077267821f7","observation_id":"aro_v1_drkp3jkexlm5whdayevty2gxiz","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","published_at":"2026-09-09T00:57:51Z","review_id":"arr_v1_mdbfomnjk5vfmshfweexnhllk7","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"0eabe9a3a6a5cb7067c6faec598d6eaf60a3010c","reviewer":"codex","start_line":148,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_xwy2qn4tfkbgrwfsfilwoq4rhj","record_type":"finding_observed","recorded_at":"2026-09-09T00:57:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P1] Gate public layer publication on Maven Central availability.** This dependency waits only for the upload to Sonatype; the release process uses `autoPublish=false` and requires a later manual publication. The workflow can therefore expose a layer whose required matching SDK is unavailable or subsequently rejected. Add a verified Central-publication milestone and make the layer depend on it, keeping version-bump PR automation independent.","comment_node_id":"PRRC_kwDOQwbyFc7sNaxE","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"07e52643820e61d3e78049ae9bc8cbe3978c1f643e0f1b429ff33b343df5e864","observation_id":"aro_v1_a7ssmq4cbzq5hz4ajgxjxsgl4o","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-08T22:45:20Z","review_id":"arr_v1_ktaetaes7aozogu23qbxtf7w7o","reviewed_base_sha":"039d443b3a8369250f8f22e5aca0c330074ad178","reviewed_head_sha":"e363945f0482e5567592654b33a507f94499d7f0","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_t77d3afwsq3hnmx35ebo5pxfbu","record_type":"finding_observed","recorded_at":"2026-09-08T22:45:20Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

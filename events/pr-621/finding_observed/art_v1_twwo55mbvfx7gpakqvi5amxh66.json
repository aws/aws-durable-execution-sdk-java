{"data":{"body":"**[P1] Gate publication on Maven Central availability.** The `publish` job only uploads to Sonatype with `autoPublish=false`, then performs unrelated version-bump automation. Consequently, the layer can become public before its required SDK is available, or be suppressed by a bump failure. Split these stages and depend on explicit Central availability verification.","comment_node_id":"PRRC_kwDOQwbyFc7sPwnX","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"33fa2613448f1a3368a3cac1e562e40dfc57e942370a719ec7cfbbc061c6bea4","observation_id":"aro_v1_gp5cme2er4ndg2fdzla6kyxebx","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-09T00:37:42Z","review_id":"arr_v1_3sofkfxs5cm4hui7ldmiaka3vy","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"79c4c665561c465edc728cd1d2c73270b764a062","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_twwo55mbvfx7gpakqvi5amxh66","record_type":"finding_observed","recorded_at":"2026-09-09T00:37:42Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

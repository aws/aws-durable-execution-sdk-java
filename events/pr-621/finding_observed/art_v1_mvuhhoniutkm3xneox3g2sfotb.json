{"data":{"body":"**[P1] Pin the layer build to the release checkout SHA.** This tag is resolved again after the Maven artifacts were built. If it moves meanwhile, the public layer can contain different code while the version and ancestry checks still pass. Export `git rev-parse HEAD` from the release checkout and pass that immutable SHA as `source_ref`, while separately verifying the tag still resolves to it.","comment_node_id":"PRRC_kwDOQwbyFc7sQZ7y","finding_digest":"5c5650029ab1e33b63713d40d7c9a322e6f265eea7abdc5c978905cf23050417","finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","finding_key":"publish_maven::publish-layer::immutable-source-selection","identity_key":"publish_maven::publish-layer::immutable-source-selection","line":148,"observation_digest":"082936e7040a6f6834d0455bf7cf2fea1c5c9a622e80c46e9c28eb092e060a09","observation_id":"aro_v1_bautnzyebjxwqngqivn7ptzp5i","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_lrlfaau2whrtwy3rhvanpsndel","published_at":"2026-09-09T01:13:41Z","review_id":"arr_v1_afho3ddh2a6emtvzgkoqep7vls","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"6d666edbc836a8a1d85481228d18162a9ca8cfa9","reviewer":"codex","start_line":148,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_mvuhhoniutkm3xneox3g2sfotb","record_type":"finding_observed","recorded_at":"2026-09-09T01:13:41Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

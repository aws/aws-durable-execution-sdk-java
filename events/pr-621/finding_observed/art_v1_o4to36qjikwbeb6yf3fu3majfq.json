{"data":{"body":"**[P1] Gate public layer publication on Maven Central availability.** This dependency waits only for upload to Sonatype; the publishing profile uses `autoPublish=false`, so a later manual publication is required. The workflow can therefore expose a layer whose required matching SDK is unavailable or subsequently rejected. Trigger the layer only after verified Central publication, keeping version-bump automation independent.","comment_node_id":"PRRC_kwDOQwbyFc7sObyn","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"9ab274419d5e9aed95b9b5b14c875f5980333240b11d9adc8357e7be3911a235","observation_id":"aro_v1_tkzhiqm5l2no3fnzwwyuzb27lg","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-08T23:35:38Z","review_id":"arr_v1_yj4bfxmolylqvpwonq2ukusfch","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"ea2e43d7591f1bb60aa55778f84ff44457146eb1","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_o4to36qjikwbeb6yf3fu3majfq","record_type":"finding_observed","recorded_at":"2026-09-08T23:35:38Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

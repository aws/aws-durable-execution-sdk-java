{"data":{"body":"**[P1] Gate layer publication on verified Maven Central availability.** `needs: publish` only waits for upload to Sonatype, while the publishing profile has `autoPublish=false`; it also couples publication to the unrelated version-bump steps. This can expose a layer before its required SDK is available, or suppress it when bump automation fails. Split those jobs, verify the required artifacts are available from Central, and make this job depend on that verification.","comment_node_id":"PRRC_kwDOQwbyFc7sPYTG","finding_digest":"2e1f9217d25b6b138490d359cf9d0286913980877f33dfbd4e2bdc07c53d34fb","finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","finding_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","identity_key":"lambda-layer-publish::release-trigger::publication-gated-by-release-validation","line":142,"observation_digest":"0073246ab5679b1394c46b73cb1d90f9c307b49fa03a6d23195f252633ab9380","observation_id":"aro_v1_abzsi2vvm6nrhfgennz4whmq7h","path":".github/workflows/publish_maven.yml","prior_finding_id":"arf_v1_fypzef6slnvrhbeq2nm47hicq2","published_at":"2026-09-09T00:19:11Z","review_id":"arr_v1_klj44nq4iivrqlfw4ss2izvyx4","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"5e0e7c990b98ce37ad85186f7908258732709284","reviewer":"codex","start_line":142,"suggestion_id":""},"pull_request":{"number":621},"record_id":"art_v1_2stotetmsptdkb3sjkklcryr5a","record_type":"finding_observed","recorded_at":"2026-09-09T00:19:11Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

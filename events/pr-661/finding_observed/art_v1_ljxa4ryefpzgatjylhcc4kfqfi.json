{"data":{"body":"**[P2] Preserve included JSON nulls**\n\nThis treats an actual `null` exactly like excluded, unavailable, or transform-failed content. A successful handler returning null therefore omits `output`, and a transform cannot intentionally emit JSON null. Track presence separately from value and omit only disabled/unavailable fields; add null input, output, and result tests.","comment_node_id":"PRRC_kwDOQwbyFc7sNybu","finding_digest":"7222336e2d78db6abd6301708845ad1644039532304641747c6281929560f9e7","finding_id":"arf_v1_oirdg3rnpdnwvpldafyiqrnncz","finding_key":"insight-plugin/workflowinsight.java::applydatacontent::explicit-null-preservation","identity_key":"insight-plugin/workflowinsight.java::applydatacontent::explicit-null-preservation","line":385,"observation_digest":"dff4065ad29d07f4c80e42d4d3a66b0c6be30b4c2ee52f63e3c094a7fd212a8c","observation_id":"aro_v1_372amwwstud7jsaoilknhjtlbr","path":"insight-plugin/src/main/java/software/amazon/lambda/durable/insight/WorkflowInsight.java","prior_finding_id":"arf_v1_oirdg3rnpdnwvpldafyiqrnncz","published_at":"2026-09-08T23:03:36Z","review_id":"arr_v1_iee7bcnfj7lcytdfodx5mvljjs","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"ce1de5fa37a2da2f6805802585eeee8390944531","reviewer":"codex","start_line":384,"suggestion_id":""},"pull_request":{"number":661},"record_id":"art_v1_ljxa4ryefpzgatjylhcc4kfqfi","record_type":"finding_observed","recorded_at":"2026-09-08T23:03:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

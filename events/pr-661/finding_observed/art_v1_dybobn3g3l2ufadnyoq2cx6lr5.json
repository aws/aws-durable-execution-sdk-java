{"data":{"body":"**[P3] Document the implemented suspension lifecycle**\n\nThe implementation removes state after every invocation end, including PENDING/RETRYING, then recreates it on resume. This paragraph states the opposite and can mislead users about warm-container retention. Update it to match the implemented lifecycle.","comment_node_id":"PRRC_kwDOQwbyFc7sNyov","finding_digest":"85a4b5136d888d400372ec68983a563d0c737c16a5982085b1775ce42810f882","finding_id":"arf_v1_qwslke3nrcguaa3s5rujqoswhu","finding_key":"insight-plugin/readme.md::per-execution-state::suspend-cleanup-documentation","identity_key":"insight-plugin/readme.md::per-execution-state::suspend-cleanup-documentation","line":45,"observation_digest":"8c24c44e153914f248e54bcd56ada608664078794ffc66603d63de1835fac04f","observation_id":"aro_v1_rqsmitqvhekpeshfjpgvnlngbb","path":"insight-plugin/README.md","prior_finding_id":"arf_v1_qwslke3nrcguaa3s5rujqoswhu","published_at":"2026-09-08T23:03:43Z","review_id":"arr_v1_iee7bcnfj7lcytdfodx5mvljjs","reviewed_base_sha":"730f534832656d1da8a3205f5468595ffb05f33d","reviewed_head_sha":"ce1de5fa37a2da2f6805802585eeee8390944531","reviewer":"codex","start_line":42,"suggestion_id":""},"pull_request":{"number":661},"record_id":"art_v1_dybobn3g3l2ufadnyoq2cx6lr5","record_type":"finding_observed","recorded_at":"2026-09-08T23:03:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

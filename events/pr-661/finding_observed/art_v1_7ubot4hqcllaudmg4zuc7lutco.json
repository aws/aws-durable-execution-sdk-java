{"data":{"body":"**[P2] Trigger the build for insight-plugin-only changes**\n\nThe main build workflow's path filters do not include `insight-plugin/**`. This PR runs because it also changes the root POM, but subsequent changes confined to the module will skip the multi-JDK Maven build and its tests. Add `insight-plugin/**` to both the pull-request and push filters in `.github/workflows/build.yml`.","comment_node_id":"PRRC_kwDOQwbyFc7nh9d1","finding_digest":"5d15d74cc7600e837d100a640f9bdf3510c773eb4a4cc90dc3bf77bdcbe0697d","finding_id":"arf_v1_luk5otghmahig7iqbjsa7g67gu","finding_key":"pom.xml::modules::insight-plugin-build-workflow-trigger","identity_key":"pom.xml::modules::insight-plugin-build-workflow-trigger","line":46,"observation_digest":"85406bc7729dbdd3fca879c84c3c3612c7f5c129421cd495a78010e8072ab070","observation_id":"aro_v1_qvagxr3stw65h7fipheeypbwcl","path":"pom.xml","prior_finding_id":"","published_at":"2026-08-28T22:27:08Z","review_id":"arr_v1_5xididmhluq4mhdhugntjpm257","reviewed_base_sha":"6501c39f553655583e33238eb1d821e4f44b8e26","reviewed_head_sha":"bdbd88fcdf777f50567d968c0e73fa11c8eb39ad","reviewer":"codex","start_line":46,"suggestion_id":""},"pull_request":{"number":661},"record_id":"art_v1_7ubot4hqcllaudmg4zuc7lutco","record_type":"finding_observed","recorded_at":"2026-08-28T22:27:08Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

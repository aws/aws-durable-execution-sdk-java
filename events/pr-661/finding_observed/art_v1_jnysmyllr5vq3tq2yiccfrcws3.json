{"data":{"body":"**[P3] Document the implemented suspension lifecycle**\n\nThe plugin actually removes state after every invocation end, including PENDING/RETRYING, then recreates it on resume. This paragraph states the opposite and can mislead users and maintainers about warm-container retention. Update it to match the implemented lifecycle.","comment_node_id":"PRRC_kwDOQwbyFc7sNGGm","finding_digest":"85a4b5136d888d400372ec68983a563d0c737c16a5982085b1775ce42810f882","finding_id":"arf_v1_qwslke3nrcguaa3s5rujqoswhu","finding_key":"insight-plugin/readme.md::per-execution-state::suspend-cleanup-documentation","identity_key":"insight-plugin/readme.md::per-execution-state::suspend-cleanup-documentation","line":45,"observation_digest":"7890d82ea6aa24ca28d5d45636d5480df9ad5598267a74f21cd11a317c9992a2","observation_id":"aro_v1_pcinqlvgvismukgv2rldnvkibx","path":"insight-plugin/README.md","prior_finding_id":"","published_at":"2026-09-08T22:32:09Z","review_id":"arr_v1_2uiyk56mbx65mvlox4bqoub2i7","reviewed_base_sha":"a28d2262c18a8a1f1b7cc7296cf2bfd166e6ca94","reviewed_head_sha":"fe682327e1d3a6d0b6defad4684bab8d594438b5","reviewer":"codex","start_line":42,"suggestion_id":"arsg_v1_76y5luhqg3ifovfilzcx6hluww"},"pull_request":{"number":661},"record_id":"art_v1_jnysmyllr5vq3tq2yiccfrcws3","record_type":"finding_observed","recorded_at":"2026-09-08T22:32:09Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

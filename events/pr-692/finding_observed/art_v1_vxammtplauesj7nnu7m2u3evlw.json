{"data":{"body":"`oldKeyNames=true` does not replace `operationId` or `operationName` on `StepContext` logs; those keys are always emitted, while only the ARN key changes. Since the preceding example is a step log, this may lead users to query for fields that never appear. Clarify that `contextId`/`contextName` apply to durable child-context logs and that step logs retain `operationId`/`operationName`.","comment_node_id":"PRRC_kwDOQwbyFc7sKRzA","finding_digest":"2596aebaa472a957d0ec7c4b9615a9ae8441ab81b4dc96cca19f01534da4860c","finding_id":"arf_v1_ewlk5oveokuvpuhmprfzmfnjv2","finding_key":"docs/advanced/logging.md::legacy-mdc-compatibility::step-key-behavior","identity_key":"docs/advanced/logging.md::legacy-mdc-compatibility::step-key-behavior","line":41,"observation_digest":"3aded965a4eac9e5c956b538ff7f6c05efd329e55d388c74f8151aa49a52b82c","observation_id":"aro_v1_hlpnszne5le6lskwwu4p673max","path":"docs/advanced/logging.md","prior_finding_id":"","published_at":"2026-09-08T20:47:54Z","review_id":"arr_v1_qk7irhhjdg23svfqjfsfxrbdzt","reviewed_base_sha":"b287ab0e0ab2f850ffcb2194a0c0c2cb27e3145b","reviewed_head_sha":"0125239a76ee87e34dbc79831ed3a0825b5ff35f","reviewer":"codex","start_line":41,"suggestion_id":""},"pull_request":{"number":692},"record_id":"art_v1_vxammtplauesj7nnu7m2u3evlw","record_type":"finding_observed","recorded_at":"2026-09-08T20:47:54Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

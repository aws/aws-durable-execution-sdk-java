{"data":{"body":"**P2 \u2014 Update the published compatibility version.** Releasing this module as 2.3.0 leaves `otel-plugin/README.md`, `OtelPluginSupport`, and related public Javadocs describing the required lifecycle capability as current in `2.2.2-SNAPSHOT`/2.2.2. Users will therefore receive compatibility guidance for a version that this change supersedes. Identify 2.3.0 as the first released core with this capability, or make the wording version-neutral.","comment_node_id":"PRRC_kwDOQwbyFc7-HaK5","finding_digest":"5a6cb19e63c03a9d7a1d5cbbba36bec9a51fe257d8d4ce7e426acc198294a68a","finding_id":"arf_v1_ljwldhtdya5j26q5ls53unv6zg","finding_key":"otel-plugin/pom.xml::project-version::stale-core-compatibility-version","identity_key":"otel-plugin/pom.xml::project-version::stale-core-compatibility-version","line":10,"observation_digest":"1375cc44a8c64e7ee231b1ef387004a934761eb76460b53c42ff647b078df34a","observation_id":"aro_v1_cn24yrfiyzhh5yrrwhxtq4aeve","path":"otel-plugin/pom.xml","prior_finding_id":"","published_at":"2026-10-13T19:57:11Z","review_id":"arr_v1_6axt7jug27s7wad4icd3rak64b","reviewed_base_sha":"1064d0ec32e5b1650b4fa08e65ca960361c7cd1b","reviewed_head_sha":"987d2ef148396c19c4249bc5cef7ccc8a7b68bf8","reviewer":"codex","start_line":10,"suggestion_id":""},"pull_request":{"number":741},"record_id":"art_v1_gsvyqmqiv4tkc4v2gckkhrmmpz","record_type":"finding_observed","recorded_at":"2026-10-13T19:57:11Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

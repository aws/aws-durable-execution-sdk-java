{"data":{"body":"**P2 \u2014 Update the published compatibility version.** Releasing this module as 2.3.0 leaves `otel-plugin/README.md`, `OtelPluginSupport`, and core Javadocs identifying the required lifecycle capability as `2.2.2-SNAPSHOT`/2.2.2, although 2.3.0 is the first release containing it. This gives users incorrect core/plugin compatibility guidance. Update those references to 2.3.0, or make them version-neutral, as part of this release.","comment_node_id":"PRRC_kwDOQwbyFc7-Lgf-","finding_digest":"5a6cb19e63c03a9d7a1d5cbbba36bec9a51fe257d8d4ce7e426acc198294a68a","finding_id":"arf_v1_ljwldhtdya5j26q5ls53unv6zg","finding_key":"otel-plugin/pom.xml::project-version::stale-core-compatibility-version","identity_key":"otel-plugin/pom.xml::project-version::stale-core-compatibility-version","line":10,"observation_digest":"49e37d88cb26d1f555ca0e5ee8e9a4080be1765166b11a0234f7d49ab5b86d67","observation_id":"aro_v1_jhrx3cgle3i7kvokbzpor2neba","path":"otel-plugin/pom.xml","prior_finding_id":"arf_v1_ljwldhtdya5j26q5ls53unv6zg","published_at":"2026-10-13T21:52:43Z","review_id":"arr_v1_vsv2rs6ylqat7l5u436txb7jfv","reviewed_base_sha":"45e4ef4720f96e0ebb348c63d43aa3eb785341eb","reviewed_head_sha":"68994a2f01440365ac207f2ebcf4f2a5b1d97d08","reviewer":"codex","start_line":10,"suggestion_id":""},"pull_request":{"number":741},"record_id":"art_v1_s5per7be3fiaaybuaxbwk2hsnx","record_type":"finding_observed","recorded_at":"2026-10-13T21:52:43Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"**[P3] Align the model-dependency guidance with the POM.** This PR pins `aws.sdk.version` to `2.56.0`, while this guide identifies `2.55.11` as the pinned model and subsequently instructs readers to rebase away from it. This directs maintainers to the wrong dependency when diagnosing propagation support. Reference the actual configured version or the root POM, and distinguish artifact/backend validation from compilation against an older model.","comment_node_id":"PRRC_kwDOQwbyFc7-4_mB","finding_digest":"2ba414b7941f981d54504b9914bb578336b99f30c9cf69ffb233f0397ae03baa","finding_id":"arf_v1_fosbjn4ud6mb2vcqjomrjo2xqm","finding_key":"docs/advanced/propagation-metadata::model-dependency::pinned-version-accuracy","identity_key":"docs/advanced/propagation-metadata::model-dependency::pinned-version-accuracy","line":47,"observation_digest":"80c8656f5fbf33214ae8ce7e9489712cf50d3be36c2c21177251039122111ec9","observation_id":"aro_v1_qdegk327x4zscsxizz7jjclrft","path":"docs/advanced/propagation-metadata.md","prior_finding_id":"arf_v1_fosbjn4ud6mb2vcqjomrjo2xqm","published_at":"2026-10-14T21:16:26Z","review_id":"arr_v1_trq55czwtan42dnljg7hhsih35","reviewed_base_sha":"f49beb68ba6c5d9970622d638fb15a2a38c63041","reviewed_head_sha":"402512b39c18a6e0066c8009615438b53b836c08","reviewer":"codex","start_line":45,"suggestion_id":""},"pull_request":{"number":768},"record_id":"art_v1_ot4j2f2btx4hr3n4vvrygttzyb","record_type":"finding_observed","recorded_at":"2026-10-14T21:16:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P3] Require JDK 21 for the documented SAM build\n\nWith only JDK 17 installed, the documented `sam build` fails runtime validation because `template.yaml` selects `Runtime: java21`. Compiling Java 17 bytecode does not satisfy SAM's runtime toolchain check. Require JDK 21 here, or document a container build for users without it.","comment_node_id":"PRRC_kwDOQwbyFc8AAAABBDNRAA","finding_digest":"7fb9128ce9c649a699b54fc481aba0153dec8d4acece46900bbce713882154e9","finding_id":"arf_v1_p64rfdhjyze2ngnvj7cidk5acu","finding_key":"conformance-tests-telemetry/readme.md::building-locally::jdk-runtime-mismatch","identity_key":"conformance-tests-telemetry/readme.md::building-locally::jdk-runtime-mismatch","line":49,"observation_digest":"24e60d724a9f966f9498b0cfe079e7b0d05e2732dc74fd83e0d09421bafbec99","observation_id":"aro_v1_etta24skt6lg7feywdh6a6phwd","path":"conformance-tests-telemetry/README.md","prior_finding_id":"","published_at":"2026-10-24T01:05:53Z","review_id":"arr_v1_4ayv4lteedahgn2nnsb3g6vmjo","reviewed_base_sha":"4b1aa82b0d898fea495cda45760ce3737fbb341e","reviewed_head_sha":"2294a33b3f876add094451c030484e8d05b61ba5","reviewer":"codex","start_line":49,"suggestion_id":"arsg_v1_gs2lq7brkqpmlmgueoa3qmeont"},"pull_request":{"number":822},"record_id":"art_v1_6txo4gt2pwcsnz2iq3tymdk3nl","record_type":"finding_observed","recorded_at":"2026-10-24T01:05:53Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

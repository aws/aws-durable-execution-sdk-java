{"data":{"body":"[P3] Require JDK 21 for the documented SAM build\n\nWith only JDK 17 installed, the documented `sam build` fails runtime validation because `template.yaml` selects `Runtime: java21`. Compiling Java 17 bytecode does not satisfy SAM's runtime toolchain check. Require JDK 21 here, or document a container build for users without it.","comment_node_id":"PRRC_kwDOQwbyFc8AAAABBDdOPw","finding_digest":"7fb9128ce9c649a699b54fc481aba0153dec8d4acece46900bbce713882154e9","finding_id":"arf_v1_p64rfdhjyze2ngnvj7cidk5acu","finding_key":"conformance-tests-telemetry/readme.md::building-locally::jdk-runtime-mismatch","identity_key":"conformance-tests-telemetry/readme.md::building-locally::jdk-runtime-mismatch","line":49,"observation_digest":"bbe7b69f20b7f33d93797e7c990e9768cc21f427dd91a1bbbd5e10b4563b280e","observation_id":"aro_v1_xpt3nhzaw7zt3e3zpz6jsduxnd","path":"conformance-tests-telemetry/README.md","prior_finding_id":"arf_v1_p64rfdhjyze2ngnvj7cidk5acu","published_at":"2026-10-24T02:34:55Z","review_id":"arr_v1_5yhn3y6y3ldu3ens7xrawlgwpe","reviewed_base_sha":"e512588a8273c225e931aa3cc6e86b5b0ceb4c22","reviewed_head_sha":"4e3d3bb02f371fe3bdf1a0593eaff518c72da603","reviewer":"codex","start_line":49,"suggestion_id":"arsg_v1_njrbjiudnjigwnbwf7guhxj7dm"},"pull_request":{"number":822},"record_id":"art_v1_3nuozos3csz24i6x2dugasdisi","record_type":"finding_observed","recorded_at":"2026-10-24T02:34:55Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

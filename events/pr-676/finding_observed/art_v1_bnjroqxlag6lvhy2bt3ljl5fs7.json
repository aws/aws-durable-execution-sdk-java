{"data":{"body":"**[P1] Enable JSON logging for the canary assertions**\n\nThis test relies on two `DurableLogger` canaries, but the module's text log pattern omits the durable execution ARN. The runner therefore cannot reliably associate those messages with this execution, particularly because CI reuses the stack and its log group. Configure JSON logging, as the existing log-asserting suites do, so requirement 11-1 can validate the intended replay.","comment_node_id":"PRRC_kwDOQwbyFc7o_g82","finding_digest":"743cf9dc1acc6c337e106e21ab5d58cb20867c7525bc83fd30b26404cf701f68","finding_id":"arf_v1_oq6ptxa2zrwdg7qqnyq2wxkyzm","finding_key":"conformance-tests/template_general.yaml::globals.function::execution-correlated-json-logging","identity_key":"conformance-tests/template_general.yaml::globals.function::execution-correlated-json-logging","line":25,"observation_digest":"f53334e86c63c5269a0f94273487ee0a626a90c5cec14f097093dc68be2b0a38","observation_id":"aro_v1_6uztj2dmmpcsngqpsqttjb7obj","path":"conformance-tests/template_general.yaml","prior_finding_id":"","published_at":"2026-09-01T22:25:50Z","review_id":"arr_v1_ckhj7wnukh7brbglsjy76l3j6o","reviewed_base_sha":"d8ed0d4a55bafe23a7f2c1fb71f66204097dda95","reviewed_head_sha":"1a38e7e594a296e1c9c81b3a0d117c9c2dd38a60","reviewer":"codex","start_line":19,"suggestion_id":"arsg_v1_cnjxjhykg6vjpi7lhf5xoo733n"},"pull_request":{"number":676},"record_id":"art_v1_bnjroqxlag6lvhy2bt3ljl5fs7","record_type":"finding_observed","recorded_at":"2026-09-01T22:25:50Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

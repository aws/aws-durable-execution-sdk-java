{"data":{"body":"**P2 \u2014 Compile LMI-only changes against Java 17**\n\nThis is the only workflow triggered by an `lmi-tests/**`-only PR, while the standard Java matrix does not watch that path. Compiling with JDK 25 and `source`/`target` 17 still permits references to post-17 JDK APIs, so such a change can merge and later break the Java 17 release build. Run this local job on JDK 17, or add `lmi-tests/**` to the standard build matrix.","comment_node_id":"PRRC_kwDOQwbyFc72oB6p","finding_digest":"05608810cc4cacca40bf90362f70d5db302e13283d1b9494335963f372c6c78f","finding_id":"arf_v1_avqiqegmjswmuqf7sa3c64gv3m","finding_key":"github/workflows/lmi-e2e-tests.yml::local-job::java17-api-compatibility","identity_key":"github/workflows/lmi-e2e-tests.yml::local-job::java17-api-compatibility","line":25,"observation_digest":"94d9e2c03150b2e170dc5d924f98840358b1953e9f7d81b3feca47062b422cc1","observation_id":"aro_v1_stm6fqbrkczoc4g4lwje7geean","path":".github/workflows/lmi-e2e-tests.yml","prior_finding_id":"","published_at":"2026-09-29T19:53:57Z","review_id":"arr_v1_re47rydfizah6aoenlhhinjdhg","reviewed_base_sha":"2ace421c3e53899e0164255b098e1d6fe9f2bae9","reviewed_head_sha":"c3fbceee6eb0dfb41d09c2b2ea6d73d820ef997e","reviewer":"codex","start_line":25,"suggestion_id":"arsg_v1_km54c4j7x5pefvlrhep3sgqwef"},"pull_request":{"number":728},"record_id":"art_v1_e7vg3nrs3wwl7drtwk2hyahz6f","record_type":"finding_observed","recorded_at":"2026-09-29T19:53:57Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

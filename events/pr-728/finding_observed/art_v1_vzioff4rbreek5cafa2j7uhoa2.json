{"data":{"body":"**P1 \u2014 Query the published qualifier before updating**\n\nStripping `:$LATEST.PUBLISHED` and omitting `Qualifier` makes this API default to `$LATEST`. Active LMI executions are therefore invisible, allowing the persistent function to be updated while an earlier run is still executing. Preserve the qualified ARN or pass the extracted qualifier explicitly, and assert that request in the persistence test.","comment_node_id":"PRRC_kwDOQwbyFc705Big","finding_digest":"909ab0c8d0ec74bb5df5943000d89a5c9116d92efcd4690984250028eaae5edf","finding_id":"arf_v1_scnlbsgq5r2lwxpvsqyabwe2ls","finding_key":"lmi-tests/cloud_suite.py::wait_for_idle_functions::published-qualifier-isolation","identity_key":"lmi-tests/cloud_suite.py::wait_for_idle_functions::published-qualifier-isolation","line":153,"observation_digest":"be17b9547d4ec94fc3af04e76850c7c3e2aec4074d2b491d367cabfa35c16145","observation_id":"aro_v1_xyl3svd5j3eu7q5pattwqughyp","path":"lmi-tests/cloud_suite.py","prior_finding_id":"","published_at":"2026-09-25T20:59:14Z","review_id":"arr_v1_sy7h523yclab4zkuqwdodvdalo","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"4f7ca72e4d42d0b067342a566230a04e9fb60198","reviewer":"codex","start_line":153,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_vzioff4rbreek5cafa2j7uhoa2","record_type":"finding_observed","recorded_at":"2026-09-25T20:59:14Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

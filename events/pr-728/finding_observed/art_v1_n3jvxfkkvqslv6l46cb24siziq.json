{"data":{"body":"**P1 \u2014 Bind timeout checks to the original runtime request**\n\nA marker spans retries, so this may select a later retry\u2019s return, potentially from another JVM. `System.nanoTime()` values are not comparable across JVMs, and a missing original wrapper exit can be hidden. Filter return, interruption, and task-exit evidence by the original `requestId` and target environment; track retry events separately.","comment_node_id":"PRRC_kwDOQwbyFc70u_am","finding_digest":"d2b115623d5bc204e600da46a27262ba38b53aeb1ba47890a5414181950d5e9e","finding_id":"arf_v1_2kyrkyr5lpbajzqa3jdke4tcxi","finding_key":"lmi-tests/cloud_suite.py::timeout_case::original-invocation-correlation","identity_key":"lmi-tests/cloud_suite.py::timeout_case::original-invocation-correlation","line":395,"observation_digest":"e12bdc77af547744b01bf744399f0df940edc8ab5c94eb4a8d56535924dd0263","observation_id":"aro_v1_4ev5y55pkr3ujma365cdthyn7f","path":"lmi-tests/cloud_suite.py","prior_finding_id":"","published_at":"2026-09-25T15:19:17Z","review_id":"arr_v1_4kgonkresrhe3zeokjr6tzopro","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"ff7d4732619701b61dc1be94834736365172cd9e","reviewer":"codex","start_line":395,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_n3jvxfkkvqslv6l46cb24siziq","record_type":"finding_observed","recorded_at":"2026-09-25T15:19:17Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

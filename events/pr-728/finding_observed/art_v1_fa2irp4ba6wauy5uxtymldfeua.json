{"data":{"body":"**P2 \u2014 Retain resources after initial provisioning failures**\n\n`create-stack` defaults to rollback. If one fixture fails provisioning, already-created functions and log groups are deleted and the resulting failed stack is rejected on the next run, defeating persistent diagnostics and requiring manual deletion. Set `OnFailure` to `DO_NOTHING` so partial resources remain for investigation and deliberate recovery.","comment_node_id":"PRRC_kwDOQwbyFc707LM0","finding_digest":"56340e77995b3af465d7693ee99ba4401610c3a14150b59296b59a6f62d7de33","finding_id":"arf_v1_ky2a454zlm5pizoxne7otg5eia","finding_key":"lmi-tests/cloud_suite.py::deploy_fixtures::failed-create-resource-retention","identity_key":"lmi-tests/cloud_suite.py::deploy_fixtures::failed-create-resource-retention","line":182,"observation_digest":"2ca727022481428973da0d90a3cf13c5b8cb3510c04eb96b2730fabd6629544d","observation_id":"aro_v1_fstsoareqfbis462bwikhtytyw","path":"lmi-tests/cloud_suite.py","prior_finding_id":"","published_at":"2026-09-25T22:32:53Z","review_id":"arr_v1_nboib46n5z3f7g4wxpljul2zix","reviewed_base_sha":"02532192eba10bfec688cd067a0d16a47ee4beea","reviewed_head_sha":"1e34529219faee623993b0462bb7fbe72a653b29","reviewer":"codex","start_line":182,"suggestion_id":"arsg_v1_vfwozixh4r5d6oo6wwidnrfuni"},"pull_request":{"number":728},"record_id":"art_v1_fa2irp4ba6wauy5uxtymldfeua","record_type":"finding_observed","recorded_at":"2026-09-25T22:32:53Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

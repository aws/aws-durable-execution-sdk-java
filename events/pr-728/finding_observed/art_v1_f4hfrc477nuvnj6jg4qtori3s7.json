{"data":{"body":"**P2 \u2014 Stop tracking gates after a successful release**\n\n`gate()` adds the name even when `release=True`, so explicitly released gates remain in `self.gates`. Cleanup consequently rewrites every release object, and a transient failure on that redundant call aborts subsequent cases despite the gate already being open. Add only held gates and discard a gate after its release succeeds; test that cleanup does not release it twice.","comment_node_id":"PRRC_kwDOQwbyFc72ulJW","finding_digest":"f9b40f4228d95d0a9bbbd3ed7bf6ca0f25ee28c304b0bdf7ac107a4a51746142","finding_id":"arf_v1_7g2a6qri3foqvg532pwxx5wkb4","finding_key":"lmi-tests/cloud_support.py::cloud.gate::released-gate-tracking","identity_key":"lmi-tests/cloud_support.py::cloud.gate::released-gate-tracking","line":276,"observation_digest":"4daff52fbf735dd9a2f7d3646a2040a55bfff77bc4f658e2fa9cc657285928c8","observation_id":"aro_v1_jwx7kl57ono5tixx2nsguicauv","path":"lmi-tests/cloud_support.py","prior_finding_id":"","published_at":"2026-09-29T23:38:39Z","review_id":"arr_v1_hkr7u6gsqc2maeaaavlmfbn3aj","reviewed_base_sha":"ef88276133d0340ce8e1319ed39639e9f66b3596","reviewed_head_sha":"3939ac94fcf23a090a4c5d31fc10e31045a9dce9","reviewer":"codex","start_line":268,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_f4hfrc477nuvnj6jg4qtori3s7","record_type":"finding_observed","recorded_at":"2026-09-29T23:38:39Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

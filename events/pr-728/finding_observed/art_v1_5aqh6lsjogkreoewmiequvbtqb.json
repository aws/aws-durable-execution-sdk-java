{"data":{"body":"**P2 \u2014 Require stable quiescence before reusing capacity**\n\nThis predicate becomes true as soon as all currently visible requests have returned. A retry queued before `stop-durable-execution` can emit `WRAPPER_ENTER` after the poll returns, occupy a lane, and make the following `overlap_case` fail despite correct SDK cleanup. Require a no-new-request quiet period after the execution is terminal, and add coverage for a delayed retry entry.","comment_node_id":"PRRC_kwDOQwbyFc7022iw","finding_digest":"e63f3cfc3d9395454df741c80461a59f4e37b3c89c501c3d074a78a97acf653f","finding_id":"arf_v1_4y7tz7b5sokuktpxiheaiynft5","finding_key":"lmi-tests/cloud_suite.py::timeout_case::durable-retry-capacity-isolation","identity_key":"lmi-tests/cloud_suite.py::timeout_case::durable-retry-capacity-isolation","line":410,"observation_digest":"a64a2fee781280e97fa4ed20c7047f03e33a46bd715581942ec3bf9415c6613d","observation_id":"aro_v1_uzfc73tyckaos75e5uqmobd7ap","path":"lmi-tests/cloud_suite.py","prior_finding_id":"arf_v1_4y7tz7b5sokuktpxiheaiynft5","published_at":"2026-09-25T19:39:56Z","review_id":"arr_v1_5fsbkll5w7rt5x7x7ibyjao4rc","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"df448f290bd4acff2b310983c5004bf55e5fa568","reviewer":"codex","start_line":406,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_5aqh6lsjogkreoewmiequvbtqb","record_type":"finding_observed","recorded_at":"2026-09-25T19:39:56Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

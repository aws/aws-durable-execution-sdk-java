{"data":{"body":"**P1 \u2014 Wait for a terminal durable status in `finish()`**\n\nAfter the first `PENDING` return, this one-shot lookup may legitimately report `RUNNING`, causing replay cases to fail before reinvocation completes. Poll the execution or history until a terminal status within `seconds`, then save and validate the final response.","comment_node_id":"PRRC_kwDOQwbyFc70u_Ql","finding_digest":"fc407ef6d736ef4a54d844a206e4c05e76abca56f37b6b4a3c949946f4d7a996","finding_id":"arf_v1_7rah55wxg3xuuvgyisranzgalz","finding_key":"lmi-tests/cloud_support.py::cloud.finish::terminal-state-polling","identity_key":"lmi-tests/cloud_support.py::cloud.finish::terminal-state-polling","line":264,"observation_digest":"fb5b723f343ae189b784c027dfde09e6ca01ef1cf8f1b88346e40fd8d216c2b2","observation_id":"aro_v1_7nnxepzuhlqytn4eyat57xqj43","path":"lmi-tests/cloud_support.py","prior_finding_id":"","published_at":"2026-09-25T15:19:13Z","review_id":"arr_v1_4kgonkresrhe3zeokjr6tzopro","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"ff7d4732619701b61dc1be94834736365172cd9e","reviewer":"codex","start_line":264,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_ori4w2aimdkict7cwkurthpuud","record_type":"finding_observed","recorded_at":"2026-09-25T15:19:13Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

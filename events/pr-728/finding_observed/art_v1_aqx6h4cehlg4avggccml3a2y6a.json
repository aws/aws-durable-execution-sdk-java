{"data":{"body":"**P2 \u2014 Observe probe invocation failures**\n\nBecause this poll omits `items=probes`, failed invocation futures are ignored and later become an SDK recovery assertion failure. Pass the probes to `poll()` and drain their futures after releasing the gate so API failures remain collection errors and cannot contaminate the final overlap check.","comment_node_id":"PRRC_kwDOQwbyFc70u_dk","finding_digest":"3283743e7448fc59b3430004a4a15555eb3e83de610c6093ca7c6b7381901cb0","finding_id":"arf_v1_gkbxiptujd6ftm2daackjikvkx","finding_key":"lmi-tests/cloud_suite.py::timeout_case::probe-request-failure-classification","identity_key":"lmi-tests/cloud_suite.py::timeout_case::probe-request-failure-classification","line":385,"observation_digest":"2f5bf802448cbc4e93a61aef032f860762bbd8ab89c417e8b649a91352d17812","observation_id":"aro_v1_f5n7qasers6e5e5gdlxqgl4ga5","path":"lmi-tests/cloud_suite.py","prior_finding_id":"","published_at":"2026-09-25T15:19:19Z","review_id":"arr_v1_4kgonkresrhe3zeokjr6tzopro","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"ff7d4732619701b61dc1be94834736365172cd9e","reviewer":"codex","start_line":385,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_aqx6h4cehlg4avggccml3a2y6a","record_type":"finding_observed","recorded_at":"2026-09-25T15:19:19Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

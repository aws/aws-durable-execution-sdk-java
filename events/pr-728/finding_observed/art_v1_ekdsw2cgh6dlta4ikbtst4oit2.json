{"data":{"body":"**P1 \u2014 Reject requests that enter but never return**\n\nThis validates only requests having a `WRAPPER_RETURN`. If one request enters and disappears while a later durable retry returns, the missing wrapper/root is ignored and lifecycle cases can pass incorrectly. Require every `(marker, environment, requestId)` entry to have a matching return, polling for delayed logs before asserting, and add a missing-return/retry test.","comment_node_id":"PRRC_kwDOQwbyFc703gIG","finding_digest":"e38abec1ada3252a3708ecf1da3d5a841a8e774ced342aa765a7b3fab7e8366d","finding_id":"arf_v1_4ofl5qnnumssunyi5ty5upk2qq","finding_key":"lmi-tests/cloud_support.py::assert_lifecycle::entered-request-must-return","identity_key":"lmi-tests/cloud_support.py::assert_lifecycle::entered-request-must-return","line":119,"observation_digest":"09c285ce6c143a36d704331466da6b8b45ee74b84dd695a599627050027aee10","observation_id":"aro_v1_bhbilttmcq5dnvyegmkgnwtlrn","path":"lmi-tests/cloud_support.py","prior_finding_id":"","published_at":"2026-09-25T20:03:29Z","review_id":"arr_v1_4g3gjtfg4uz66bh74knsmw5pvh","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"b36047acb3afdd294ad3421e751071036c76a47d","reviewer":"codex","start_line":118,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_ekdsw2cgh6dlta4ikbtst4oit2","record_type":"finding_observed","recorded_at":"2026-09-25T20:03:29Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

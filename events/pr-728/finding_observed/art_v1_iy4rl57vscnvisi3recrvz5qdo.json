{"data":{"body":"**P2 \u2014 Run local fixture checks without the cloud label**\n\nThis job-level condition also skips the Maven build, Spotless check, and Python evidence tests. Since the normal build workflow does not watch `lmi-tests/**`, an unlabeled fixture-only PR receives no CI validation. Split unconditional local checks into a separate job or gate only deployment and cloud-test steps.","comment_node_id":"PRRC_kwDOQwbyFc70u_lT","finding_digest":"6635488155300267d83b219764087365cfe0d60e921a53952f6f9dfd85726ed1","finding_id":"arf_v1_my2urakvgabgpwb3eglwicdtmx","finding_key":"github/workflows/lmi-e2e-tests.yml::jobs.cloud.if::local-validation-gated","identity_key":"github/workflows/lmi-e2e-tests.yml::jobs.cloud.if::local-validation-gated","line":29,"observation_digest":"24aea8ef74971fb938df75373eb2f7b94421343cbb7c9a2c7b176e1925b16c12","observation_id":"aro_v1_esxkr33us4p3sog7ou3t5mxxxf","path":".github/workflows/lmi-e2e-tests.yml","prior_finding_id":"","published_at":"2026-09-25T15:19:23Z","review_id":"arr_v1_4kgonkresrhe3zeokjr6tzopro","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"ff7d4732619701b61dc1be94834736365172cd9e","reviewer":"codex","start_line":25,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_iy4rl57vscnvisi3recrvz5qdo","record_type":"finding_observed","recorded_at":"2026-09-25T15:19:23Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

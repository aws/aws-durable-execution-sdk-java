{"data":{"body":"**P1 \u2014 Prove healthy peers were active before the deadline**\n\nPlacement may continue past the victim deadline, but this accepts a peer whose first heartbeat occurs afterward. Such a peer can overlap the allowed cleanup window and make the case pass without proving that a healthy invocation progressed through the timeout. Require the bound peer request to enter or heartbeat before the deadline and heartbeat afterward; add a late-admission negative test.","comment_node_id":"PRRC_kwDOQwbyFc705Blj","finding_digest":"daa9645f30c7c4dcced61c97bc076d052d2005893c4603f61fb3e6090289def4","finding_id":"arf_v1_3kuwixzqy7cnztwwdsl3yb3nau","finding_key":"lmi-tests/cloud_suite.py::timeout_evidence_ready::healthy-peer-deadline-bracketing","identity_key":"lmi-tests/cloud_suite.py::timeout_evidence_ready::healthy-peer-deadline-bracketing","line":461,"observation_digest":"c4390bcbeff99b280889d56e257a50fc35260f145311abc9b4f3fc3f9a3d44a0","observation_id":"aro_v1_yq4qxs7p7gnsqcej2vxck6sq7q","path":"lmi-tests/cloud_suite.py","prior_finding_id":"","published_at":"2026-09-25T20:59:15Z","review_id":"arr_v1_sy7h523yclab4zkuqwdodvdalo","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"4f7ca72e4d42d0b067342a566230a04e9fb60198","reviewer":"codex","start_line":459,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_5kmc4uwh5ktvsp5vnhb4mwwb45","record_type":"finding_observed","recorded_at":"2026-09-25T20:59:15Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

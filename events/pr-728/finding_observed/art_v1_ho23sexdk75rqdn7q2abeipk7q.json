{"data":{"body":"**P2 \u2014 Wait for recovery logs before evaluating recovery**\n\nThis poll can finish without observing any target-JVM probe `TASK_ENTER`, yet `recovered` is immediately read from the cache below. Probe logs may arrive after victim/peer logs even though invocation futures completed, falsely failing a correct recovery. Include bounded probe admission in the readiness predicate, or poll for it separately, and add delayed-probe-log coverage.","comment_node_id":"PRRC_kwDOQwbyFc706o_m","finding_digest":"e793d1b578268569262143a7a050488ed64a929cfbe92809732f3914e7fed462","finding_id":"arf_v1_46j5dnlye2cwsjrbiot2aucir3","finding_key":"lmi-tests/cloud_suite.py::assert_timeout_case::required-cloudwatch-evidence-readiness","identity_key":"lmi-tests/cloud_suite.py::assert_timeout_case::required-cloudwatch-evidence-readiness","line":544,"observation_digest":"4b3d38df75f9f0f06087e42094f00751ab00c441b232d0df4e03d08af1d6f64b","observation_id":"aro_v1_jm6trx3v7hypayeh4qqjj4ahkg","path":"lmi-tests/cloud_suite.py","prior_finding_id":"arf_v1_46j5dnlye2cwsjrbiot2aucir3","published_at":"2026-09-25T22:06:37Z","review_id":"arr_v1_4f44et3ecyjfyjfab3zoo4hced","reviewed_base_sha":"518cba16e0e690e1939feff222915ce841aa960b","reviewed_head_sha":"45bf23af7e0581f39e157b69352b7cd81285a00c","reviewer":"codex","start_line":539,"suggestion_id":""},"pull_request":{"number":728},"record_id":"art_v1_ho23sexdk75rqdn7q2abeipk7q","record_type":"finding_observed","recorded_at":"2026-09-25T22:06:37Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

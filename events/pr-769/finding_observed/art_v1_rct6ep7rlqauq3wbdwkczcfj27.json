{"data":{"body":"[P2] This catches `VirtualMachineError` and `ThreadDeath`, then continues invoking arbitrary cleanup hooks. If a subsequent hook blocks, the fatal condition never escapes and execution remains in a potentially corrupted JVM. Re-throw JVM-fatal errors immediately; aggregate and continue cleanup only for nonfatal errors.","comment_node_id":"PRRC_kwDOQwbyFc7749-Z","finding_digest":"c92b7c1747a290739ec238dd4ec3ebca21a44760e63e5f5597374768eeaf7d5f","finding_id":"arf_v1_zevxyf2hukihhhwchdou5q7lzi","finding_key":"sdk/execution/durableexecutor::finalizeafterhandlerscopes::scope-fatal-observation-liveness","identity_key":"sdk/execution/durableexecutor::finalizeafterhandlerscopes::scope-fatal-observation-liveness","line":113,"observation_digest":"405eb3a784f982566d1deb459c6df1fa1443e381e8a80cd5a89af67cb1af222c","observation_id":"aro_v1_ibplhj4e7gbfm3i55nczy3pr7i","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/PluginRunner.java","prior_finding_id":"arf_v1_zevxyf2hukihhhwchdou5q7lzi","published_at":"2026-10-09T02:20:24Z","review_id":"arr_v1_hyhhujz5d345gd5gjgv3rog337","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"c59039a8be52bf63f76d100110e28cd66d4ec510","reviewer":"codex","start_line":113,"suggestion_id":""},"pull_request":{"number":769},"record_id":"art_v1_rct6ep7rlqauq3wbdwkczcfj27","record_type":"finding_observed","recorded_at":"2026-10-09T02:20:24Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Reversing `onInvocationEnd` silently breaks the released `withPlugins` contract that hooks run in registration order. Existing plugins coordinating ordered flushing or shared-resource cleanup can behave differently after a patch upgrade. Preserve forward order for existing plugins, or introduce an explicit versioned/opt-in scoped-lifecycle contract for LIFO cleanup.","comment_node_id":"PRRC_kwDOQwbyFc774-Be","finding_digest":"228b02e451d041f1350baeb06c1087e868a78673c95bfbe462221502988bf67c","finding_id":"arf_v1_ekfqfzcr2ba7cnilv2ygyeeh5b","finding_key":"sdk/plugin/pluginrunner::oninvocationend::registration-order-compatibility","identity_key":"sdk/plugin/pluginrunner::oninvocationend::registration-order-compatibility","line":110,"observation_digest":"5f7a210046e11d044e9b12fdeeb5c5db949be851da040a683a4111784dff1af5","observation_id":"aro_v1_l55ccacg4eoqitu3cl665nof3o","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/PluginRunner.java","prior_finding_id":"arf_v1_ekfqfzcr2ba7cnilv2ygyeeh5b","published_at":"2026-10-09T02:20:26Z","review_id":"arr_v1_hyhhujz5d345gd5gjgv3rog337","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"c59039a8be52bf63f76d100110e28cd66d4ec510","reviewer":"codex","start_line":110,"suggestion_id":""},"pull_request":{"number":769},"record_id":"art_v1_ultemdyokefrngjltqqcckdwkt","record_type":"finding_observed","recorded_at":"2026-10-09T02:20:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

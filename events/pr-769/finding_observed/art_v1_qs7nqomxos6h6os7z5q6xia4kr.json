{"data":{"body":"[P2] This catches VM-fatal errors such as `VirtualMachineError` and `ThreadDeath`, then continues invoking arbitrary plugin cleanup. If a later hook blocks, the fatal condition may never escape. Re-throw VM-fatal errors immediately and aggregate/continue only for non-fatal cleanup errors.","comment_node_id":"PRRC_kwDOQwbyFc774nlF","finding_digest":"c92b7c1747a290739ec238dd4ec3ebca21a44760e63e5f5597374768eeaf7d5f","finding_id":"arf_v1_zevxyf2hukihhhwchdou5q7lzi","finding_key":"sdk/execution/durableexecutor::finalizeafterhandlerscopes::scope-fatal-observation-liveness","identity_key":"sdk/execution/durableexecutor::finalizeafterhandlerscopes::scope-fatal-observation-liveness","line":113,"observation_digest":"99c94357965a316155b4a2604f923a3e50a29de5a94efaacc6a9ed0cd8ce5dff","observation_id":"aro_v1_theugv4wliywcvnuujqe7er2hz","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/PluginRunner.java","prior_finding_id":"arf_v1_zevxyf2hukihhhwchdou5q7lzi","published_at":"2026-10-09T01:59:58Z","review_id":"arr_v1_5zfolgp3vq7gwoomppogn5kpej","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"f6d734424f8df2dadb2d75fac3942b1a8d883952","reviewer":"codex","start_line":113,"suggestion_id":""},"pull_request":{"number":769},"record_id":"art_v1_qs7nqomxos6h6os7z5q6xia4kr","record_type":"finding_observed","recorded_at":"2026-10-09T01:59:58Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth record component breaks recompilation of seven-component record patterns and changes reflection, equality, and hashing semantics; retaining the old constructors does not preserve these contracts. Keep `InvocationInfo` at seven components and carry the header through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)`.","comment_node_id":"PRRC_kwDOQwbyFc772vHc","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"c02f7b51269ba8fb71336597ff083913ab1445f17aa1abd718889e4fe5379b1d","observation_id":"aro_v1_yaxxwujgtoupw4jtmwl76cbzco","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-09T00:16:12Z","review_id":"arr_v1_teifsc6flrmfsfzsn5wjrybyml","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"a9ea8702be63eb9bc95ee7601cb5f4aa4d37c40b","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_42zlqtg5pbaxcso6t27zjh2qvg","record_type":"finding_observed","recorded_at":"2026-10-09T00:16:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

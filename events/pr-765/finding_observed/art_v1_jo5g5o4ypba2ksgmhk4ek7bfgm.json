{"data":{"body":"[P2] Adding an eighth component breaks source compatibility for clients using the released seven-component record pattern and changes reflection, equality, and hashing semantics. Retaining the old constructors does not preserve that contract. Keep `InvocationInfo` at seven components and deliver the snapshot through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)`.","comment_node_id":"PRRC_kwDOQwbyFc77yyak","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"c3a1ba944a9d131b2274019161b1d67b891a8b017b80293af02d3dfab59a0f81","observation_id":"aro_v1_yoq3vfcktujrwituagiwdmowpo","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-08T21:37:51Z","review_id":"arr_v1_ad63fob2qvlhr3hmrykcvqcaxx","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"0a05f833563250af3e6ad4fd7c72eb10d7e4e2f0","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_jo5g5o4ypba2ksgmhk4ek7bfgm","record_type":"finding_observed","recorded_at":"2026-10-08T21:37:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth record component breaks recompilation of existing seven-component record patterns and changes public reflection, equality, and hashing semantics. Retaining the old constructor does not preserve these contracts. Keep the record at seven components and carry the snapshot through separate immutable hook metadata, such as a new default plugin-hook overload that delegates to the existing hook.","comment_node_id":"PRRC_kwDOQwbyFc7-IutQ","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"28ffa6a8ea47c75b7b772342413c505d0fc7c46a7c731ed4178b9a95fb41fac3","observation_id":"aro_v1_fd72nkhki7dvw63xenbecpcqlu","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-13T20:31:55Z","review_id":"arr_v1_5i36ssxvfnj4pbjenrcfxfm7ma","reviewed_base_sha":"45e4ef4720f96e0ebb348c63d43aa3eb785341eb","reviewed_head_sha":"8468b3d0d68d9f01b39573370c1613b2e853f364","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_kcrfnhc4srvgrhof7xjpbl3pxq","record_type":"finding_observed","recorded_at":"2026-10-13T20:31:55Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth record component breaks public compatibility: existing Java 21 record patterns no longer compile, while reflection, serializer-visible shape, equality, and hash codes change. Retaining the seven-argument constructor does not preserve these contracts. Keep `InvocationInfo` at seven components and carry the snapshot through separate immutable metadata, such as a default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)` method.","comment_node_id":"PRRC_kwDOQwbyFc77GJkG","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"3198a4ab0c9a4ef73d6af550e2686b1717046b46efddf8d1f65444d8399aaec0","observation_id":"aro_v1_ggmkjkymtjhpoplk6vioe2dlc4","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-07T22:30:30Z","review_id":"arr_v1_ugupdvgpwqzljrq77qccapg3fi","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"8cae9c016ca2ac1ea34942b185e0618aacc4f198","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_rpz73fdsho46ezh5dhbsdrfetm","record_type":"finding_observed","recorded_at":"2026-10-07T22:30:30Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth component breaks this public record\u2019s contract: existing seven-component record patterns no longer compile, while reflection, serializers, equality, and hashing observe a different shape. The retained constructor does not preserve these contracts. Keep `InvocationInfo` at seven components and carry the header through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)`.","comment_node_id":"PRRC_kwDOQwbyFc77pmqO","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"4777a548cab0d8af0bdf62e76e6ed61021c348a15e3bfb90d8b32484d9d90332","observation_id":"aro_v1_i532ksgkwdmk6c67mltw43wwca","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-08T17:13:01Z","review_id":"arr_v1_6fta7eo47mvedrmtpqlxphhbxc","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"fdc8c2d3a700bdfe9ca14ceb0e69a836c0604011","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_uwesfitzh5e6avtcrzxovtg2zh","record_type":"finding_observed","recorded_at":"2026-10-08T17:13:01Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

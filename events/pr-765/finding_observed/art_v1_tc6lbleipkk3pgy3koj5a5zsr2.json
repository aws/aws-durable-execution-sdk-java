{"data":{"body":"[P2] Making `xRayTraceId` an eighth record component breaks recompilation of seven-component record patterns and changes public reflection, equality, and hashing behavior; retaining the old constructors does not preserve these contracts. Keep `InvocationInfo` at seven components and carry the snapshot through separate immutable hook metadata, such as a new default plugin-hook overload that delegates to the existing hook.","comment_node_id":"PRRC_kwDOQwbyFc7-HV8t","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"9f075aa8464e1430ae45b97f827f8c826e1ca221dbe3f1291b5f818fc2345f1f","observation_id":"aro_v1_t4dvvkcgjykdblsfxf7ye74mqj","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-13T19:55:19Z","review_id":"arr_v1_ve34tglxhbn3dt2rm6k352elmy","reviewed_base_sha":"1064d0ec32e5b1650b4fa08e65ca960361c7cd1b","reviewed_head_sha":"9ce04ce582814d2cae4cf3605fa7e4f8d9507d13","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_tc6lbleipkk3pgy3koj5a5zsr2","record_type":"finding_observed","recorded_at":"2026-10-13T19:55:19Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

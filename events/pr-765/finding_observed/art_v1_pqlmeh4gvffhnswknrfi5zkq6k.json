{"data":{"body":"[P2] Retaining the old constructor does not preserve this public record\u2019s contract: existing seven-component record patterns stop compiling, while equality, hashing, reflection, and serializer-visible shape now include the header. Keep `InvocationInfo` at seven components and carry the snapshot in separate immutable metadata, delivered through a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)` hook.","comment_node_id":"PRRC_kwDOQwbyFc77SAuS","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"c3f1f4f1c15d7e1014a51a6ae8a086b8135a227567baef2a68aab48c459a3af1","observation_id":"aro_v1_ypy7j4oblv7bafffdjvoriegxa","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-08T06:48:25Z","review_id":"arr_v1_2wkhqcd6rmfjxut5dlrzzsxnec","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"506949ecb90c18502fca578c0dfa7083e1df4584","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_pqlmeh4gvffhnswknrfi5zkq6k","record_type":"finding_observed","recorded_at":"2026-10-08T06:48:25Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

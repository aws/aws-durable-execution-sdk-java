{"data":{"body":"[P2] Preserve `InvocationInfo`'s public seven-component record shape. Adding this component breaks recompilation of existing record patterns and changes reflection, equality/hash-code, and serializer-visible shape; retaining the old constructor only preserves constructor calls. Carry the header through a companion metadata type and a default hook overload that delegates to the existing `onInvocationStart(InvocationInfo)` method.","comment_node_id":"PRRC_kwDOQwbyFc76j2DS","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"951e6d9e5846436c66ec50a39be0479111b0aa6ad0a9a9545e3ea7616273e83b","observation_id":"aro_v1_supg3hsyizbwyzxmkcrzxychse","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-07T06:16:36Z","review_id":"arr_v1_zrigs27mdjkwy6ru3apmderzoj","reviewed_base_sha":"34c174f2819f715cf26e88aa8dbabd7d40cb9ad8","reviewed_head_sha":"f2bd421238c1066e50468319e35ea659f4c528ad","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_foe6a55xop7diifnlwsjgg2num","record_type":"finding_observed","recorded_at":"2026-10-07T06:16:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

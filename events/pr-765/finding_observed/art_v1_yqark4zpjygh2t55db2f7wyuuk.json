{"data":{"body":"[P2] Adding an eighth record component breaks recompilation of seven-component record patterns and changes reflection, equality, and hashing semantics; retaining the old constructors does not preserve these contracts. Keep `InvocationInfo` at seven components and carry the header through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)`.","comment_node_id":"PRRC_kwDOQwbyFc774Tn9","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"321f3445c2942f621c592e689e7e694cd9f6a15d1f48e0405d4ab32a1988ec20","observation_id":"aro_v1_giptirocsqxwehczfzuj47tjjt","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-09T01:41:57Z","review_id":"arr_v1_mzsmprnhrmnxmn3jrnckgktulh","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"7a4b81a5e4ac6a6c06c72d0c5634842c67fdbba8","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_yqark4zpjygh2t55db2f7wyuuk","record_type":"finding_observed","recorded_at":"2026-10-09T01:41:57Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

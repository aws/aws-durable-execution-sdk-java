{"data":{"body":"[P2] Preserve `InvocationInfo`'s public seven-component record shape. This component breaks recompilation of existing record patterns and changes reflection, equality/hash-code, and serializer-visible shape; retaining the old constructor only preserves constructor calls. Carry the header through a companion metadata type and a default hook overload that delegates to the existing `onInvocationStart(InvocationInfo)` method.","comment_node_id":"PRRC_kwDOQwbyFc76feCs","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"6810866d2bca9ac99a80c80d4ab9b367a799946a6c4ea17ea9f681b5a27c55cb","observation_id":"aro_v1_naiim3jlzknmtguazaguvontm6","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-07T02:48:48Z","review_id":"arr_v1_ggqd2s3m2zpobqb47a65bpj76j","reviewed_base_sha":"34c174f2819f715cf26e88aa8dbabd7d40cb9ad8","reviewed_head_sha":"a74b26b15216e650e40263fea257d8519b70f21b","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_5i3ktfpusbsim7wbj2j3bebbub","record_type":"finding_observed","recorded_at":"2026-10-07T02:48:48Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth record component breaks recompilation of seven-component record patterns and changes reflection, equality, and hashing contracts. Retaining constructors does not preserve these public APIs. Keep the record at seven components and pass the header through separate immutable metadata, such as a new default plugin-hook overload delegating to the existing hook.","comment_node_id":"PRRC_kwDOQwbyFc7-Dtip","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"591302ac9190154b2a8e8a14c47bee8d7946e4a56188146f9eb8478f026e74e0","observation_id":"aro_v1_lejqflersakuwkuorikmi67orv","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-13T18:19:08Z","review_id":"arr_v1_4kx76phfuc6jjlgxo4ldpuzjpc","reviewed_base_sha":"bdc1c708ba096fe1d20519e578f972b762242995","reviewed_head_sha":"05e32b6bcacefc9d71d0fb62fcfcd55e89119051","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_aigqv4oqtuqelnj3qchwgoydfo","record_type":"finding_observed","recorded_at":"2026-10-13T18:19:08Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

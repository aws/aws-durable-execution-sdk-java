{"data":{"body":"[P2] Adding an eighth public record component breaks recompilation of seven-component record patterns and changes reflection, equality, and hashing semantics; retaining the old constructors only preserves constructor calls. Keep `InvocationInfo` at seven components and pass the header through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)`.","comment_node_id":"PRRC_kwDOQwbyFc77071N","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"3445d91f5a2bbfcd92daff26bd13a867b4c41a947dc0ed359be65a6756982a35","observation_id":"aro_v1_grc5sh22fo743ew274tl2e5im6","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-08T22:54:02Z","review_id":"arr_v1_qcc4exfiiixjvwmkt3cpqy7coz","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"6f4d81ac9cbb021017d0f9bb9298bbbd3685a267","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_nu6fofzimxnyhqor7tyhwm4hal","record_type":"finding_observed","recorded_at":"2026-10-08T22:54:02Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Adding an eighth component breaks this public record\u2019s contract: existing seven-component record patterns no longer compile, while reflection, serializers, equality, and hashing observe a different shape. The retained constructor does not preserve these contracts. Keep `InvocationInfo` at seven components and pass the header through separate immutable metadata, such as a new default plugin-hook overload that delegates to the existing `onInvocationStart(InvocationInfo)` method.","comment_node_id":"PRRC_kwDOQwbyFc77SdnW","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"f1c45406ff42e96496b0b8b4ca029e01d45214e060cdb1e2ce4f8067f82b4129","observation_id":"aro_v1_6hcfibx7iluwjfvqxc2muau6ah","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-08T07:01:12Z","review_id":"arr_v1_xntuapyow5jkuqfwahlewf5moa","reviewed_base_sha":"0c8618e42d3b16e9b7115ab943a93253c0fe936c","reviewed_head_sha":"4f46c325478adec18edc40b366a1030c6be44175","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_q2243t6ycmy2r6w5hea4rndjzr","record_type":"finding_observed","recorded_at":"2026-10-08T07:01:12Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

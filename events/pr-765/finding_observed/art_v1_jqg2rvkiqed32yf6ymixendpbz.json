{"data":{"body":"[P2] Preserve the public seven-component record shape. Adding an eighth component breaks recompilation of existing Java record patterns and changes reflection, equality, and hash-code behavior; retaining the old constructor does not prevent those API regressions. Carry the header through an additive/versioned hook or companion metadata type while leaving `InvocationInfo` unchanged.","comment_node_id":"PRRC_kwDOQwbyFc75y7ZP","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"96828bc3a4d21c008f2f3d1f67f79be06274edf32530160fea39be89ce7789ce","observation_id":"aro_v1_s2bixq5e2ioabdzphupwp5434b","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-06T02:18:51Z","review_id":"arr_v1_m4marjzyf4hf6xsleu3dzf7el4","reviewed_base_sha":"ac6a6f5ea50d6a9098b716905f01c609e4c201ae","reviewed_head_sha":"9e5a55f374f5666f7203bcd609c66c21d959ece4","reviewer":"codex","start_line":37,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_jqg2rvkiqed32yf6ymixendpbz","record_type":"finding_observed","recorded_at":"2026-10-06T02:18:51Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

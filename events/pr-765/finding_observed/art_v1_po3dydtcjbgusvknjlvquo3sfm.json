{"data":{"body":"[P2] Preserve the public seven-component record shape. Adding an eighth component breaks recompilation of existing record patterns and changes reflection, serialization, equality, and hash-code behavior; retaining the old constructor does not preserve those contracts. Carry the header through an additive hook or companion metadata type while leaving `InvocationInfo` unchanged.","comment_node_id":"PRRC_kwDOQwbyFc75zdx1","finding_digest":"32d77b84d4097416e8b5d61e3b981eaeb448a2af0042bfecaa9021e1f750a58b","finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","finding_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","identity_key":"sdk/plugin/invocationinfo::record-components::public-source-compatibility","line":38,"observation_digest":"c37e6d9d763b5e0f6d7b7dce1a5d9d2bf8cb238869792a529c3492e49a889c43","observation_id":"aro_v1_yn7g3hlwhnpa63l3pxhbuxm5fp","path":"sdk/src/main/java/software/amazon/lambda/durable/plugin/InvocationInfo.java","prior_finding_id":"arf_v1_gllxxbgubf2bn2fv2ypdxga6v2","published_at":"2026-10-06T02:44:26Z","review_id":"arr_v1_7smwhdaz3s4oikldt7j2vjymsc","reviewed_base_sha":"ac6a6f5ea50d6a9098b716905f01c609e4c201ae","reviewed_head_sha":"a8b5d8bf106c77184a524e62e408b1a379571dec","reviewer":"codex","start_line":38,"suggestion_id":""},"pull_request":{"number":765},"record_id":"art_v1_po3dydtcjbgusvknjlvquo3sfm","record_type":"finding_observed","recorded_at":"2026-10-06T02:44:26Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

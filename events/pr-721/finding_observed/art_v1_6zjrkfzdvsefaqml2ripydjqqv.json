{"data":{"body":"**[P1] Keep the existing public plugin registration contract.** Replacing `withPlugins(DurableExecutionPlugin...)` breaks source compatibility and causes already-built handlers to fail with `NoSuchMethodError`. Add the factory API alongside a deprecated instance overload, and retain deprecated bridges for the other public removals in this change, or defer them to a major release.","comment_node_id":"PRRC_kwDOQwbyFc7wrPOy","finding_digest":"ad543aeed99c53767f9a6bef126dc6b07338d587873719f0f099ae0d81b5ff79","finding_id":"arf_v1_vvkdv3wztrjxm742npxre3ogwb","finding_key":"sdk/src/main/java/software/amazon/lambda/durable/durableconfig.java::builder.withplugins::public-api-compatibility","identity_key":"sdk/src/main/java/software/amazon/lambda/durable/durableconfig.java::builder.withplugins::public-api-compatibility","line":477,"observation_digest":"0fc09040b4e41de1c83db16729c5315cebe128b506af1181e9329954c6a949b5","observation_id":"aro_v1_b7ajaqfu4qo6dsb5wftstrjrlt","path":"sdk/src/main/java/software/amazon/lambda/durable/DurableConfig.java","prior_finding_id":"","published_at":"2026-09-17T14:16:47Z","review_id":"arr_v1_ngxfyv63p4lqudenuthqx2ntut","reviewed_base_sha":"adb57764dd7b0d927e52f756ecb9bca4eb0f5a91","reviewed_head_sha":"6cca5434eabe54d85f0c08613b2938245c70d29e","reviewer":"codex","start_line":477,"suggestion_id":""},"pull_request":{"number":721},"record_id":"art_v1_6zjrkfzdvsefaqml2ripydjqqv","record_type":"finding_observed","recorded_at":"2026-09-17T14:16:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

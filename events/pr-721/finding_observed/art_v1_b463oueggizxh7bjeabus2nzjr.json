{"data":{"body":"**[P3] Do not expect the 2.x probe to succeed with 3.x artifacts.** The probe is compiled against the old core and calls the removed provider methods and plugin constructors, so `old/new`, `new/old`, and `new/new` fail with linkage errors before testing header dispatch; only `old/old` can pass. Rewrite the probe for the factory API and assert expected cross-major rejection, or restrict this harness explicitly to 2.x artifacts.","comment_node_id":"PRRC_kwDOQwbyFc74pJ0c","finding_digest":"84356611d7efcbef7f759aa8cd9816ca3fba80c9848bbdd30d56e642ee20d526","finding_id":"arf_v1_qq2wmeox57f6673vtkum3gawzi","finding_key":"otel-plugin/src/test/compatibility/run_matrix.py::compatibility-matrix::cross-major-success-expectation","identity_key":"otel-plugin/src/test/compatibility/run_matrix.py::compatibility-matrix::cross-major-success-expectation","line":33,"observation_digest":"9358af01a977119ac159a3cac4102e26afd6b6110f2aa773862618d7c5b588bf","observation_id":"aro_v1_snmk6anjo4izvqkzupfmieboe2","path":"otel-plugin/src/test/compatibility/run_matrix.py","prior_finding_id":"","published_at":"2026-10-03T03:34:47Z","review_id":"arr_v1_z6oi3g5fbnek4iawnt2wtkqxrf","reviewed_base_sha":"61f5d103651c2bafc54f840a539cf55a95f47df7","reviewed_head_sha":"c6a16af9c6bd5950227e871adcfc3ded02a96939","reviewer":"codex","start_line":30,"suggestion_id":""},"pull_request":{"number":721},"record_id":"art_v1_b463oueggizxh7bjeabus2nzjr","record_type":"finding_observed","recorded_at":"2026-10-03T03:34:47Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}

{"data":{"body":"[P2] Specify the `producerContext` wire schema. Java requires this object and passes it to `PayloadOffloader.load`, but this document never defines its property names, nullability, enum encodings, or stable `entityId` construction. Another SDK therefore cannot reliably produce an envelope Java will accept. Add a normative field table or JSON example covering every context field and the execution/operation entity-ID rules.","comment_node_id":"PRRC_kwDOQwbyFc7ppnGb","finding_digest":"52d0b59fc9ee54832cce9751fe6b59e4ad81cb0f5e04abba1c1c06f40af06931","finding_id":"arf_v1_klillh6j5zkiglgos5i7422z4s","finding_key":"docs/wire-formats/payload-offloader.md::producercontext::wire-schema-undefined","identity_key":"docs/wire-formats/payload-offloader.md::producercontext::wire-schema-undefined","line":75,"observation_digest":"a3ed86979e6e2f7691acd45dc59128e5ac0ade9cb84b4845fae8570caf4eac68","observation_id":"aro_v1_upwynf46nyxxnenm2ro4leji4w","path":"docs/wire-formats/payload-offloader.md","prior_finding_id":"","published_at":"2026-09-03T00:43:36Z","review_id":"arr_v1_54rqfgiwjoacw33nnmu3xybj24","reviewed_base_sha":"9f353ea2a1d728885c69a203b7733e728ec7bc2e","reviewed_head_sha":"fbfc064364bdc1c59fb7a93ba3cef2a6b2ba5ecb","reviewer":"codex","start_line":71,"suggestion_id":""},"pull_request":{"number":683},"record_id":"art_v1_4kkbu5d5hmb2len775bznbp2v4","record_type":"finding_observed","recorded_at":"2026-09-03T00:43:36Z","repository":{"full_name":"aws/aws-durable-execution-sdk-java","id":1124528661},"schema_version":1}
